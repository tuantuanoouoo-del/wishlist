# ============================================================
#  个人心愿单 Wishlist —— 后端配置示例
#  使用方法：复制本文件为 .env，并填入你的 RAWG API Key
#     Windows:  copy .env.example .env
#     macOS/Linux:  cp .env.example .env
# ============================================================

# RAWG API Key（必填，用于游戏搜索 / 详情 / 图片）
# 免费注册与获取：https://rawg.io/apidocs
RAWG_API_KEY=

# 服务监听端口（默认 8787）
PORT=8787

# 服务监听地址（默认 127.0.0.1，仅本机访问；设为 0.0.0.0 可让局域网内手机访问）
HOST=127.0.0.1

# RAWG API 基础地址（一般无需修改）
RAWG_BASE_URL=https://api.rawg.io/api

# Supabase（用于餐厅收藏的图片上传；填你自己的项目地址与 anon key）
# 获取：Supabase 后台 → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ============================================================
#  代理 / VPN 配置（可选）
# ------------------------------------------------------------
#  如果你的网络需要代理才能访问 api.rawg.io，取消注释并填入
#  你的代理地址（常见：Clash=7890，V2RayN=10809 等，以你客户端为准）。
#  填好后用 `node start.js` 或 `npm start` 启动。
# ============================================================
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
